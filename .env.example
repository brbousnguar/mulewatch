# --- Authentication (pick one) -------------------------------------------
# Recommended: a connected app with "acts on its own behalf" enabled.
ANYPOINT_CLIENT_ID=your_connected_app_client_id
ANYPOINT_CLIENT_SECRET=your_connected_app_client_secret

# Alternative: platform login.
# ANYPOINT_USERNAME=you@example.com
# ANYPOINT_PASSWORD=your_password

# Alternative: a pre-generated bearer token (takes precedence over the above).
# ANYPOINT_ACCESS_TOKEN=your_bearer_token

# --- Scope ----------------------------------------------------------------
# Business group id. Leave unset to use the credentials' own organization.
# ANYPOINT_ORG_ID=

# Restrict every tool to these environments (names or ids, comma-separated).
# Leave unset to allow all environments the credentials can see.
# ANYPOINT_ALLOWED_ENVIRONMENTS=Development,Sandbox

# --- Hosts (override for EU/gov control planes) ---------------------------
# ANYPOINT_BASE_URL=https://anypoint.mulesoft.com
# ANYPOINT_MONITORING_BASE_URL=https://monitoring.anypoint.mulesoft.com
